{
  "theme": {
    "accent": "#fb923c",
    "opacity": 0.64,
    "radius": 28,
    "font_family": "JetBrains Mono",
    "preset": "Tokyo Night"
  },
  "bar": {
    "height": 36,
    "clock_format": "HH:mm",
    "show_date": true,
    "ws_width": 39,
    "ws_height": 14,
    "ws_radius": 7,
    "show_seconds": true,
    "show_gpu": true,
    "show_temp": true,
    "show_perf": true
  },
  "dock": {
    "enabled": true,
    "icon_size": 48,
    "auto_hide": true,
    "margin": 20,
    "monitor": "",
    "opacity": 0.59
  },
  "launcher": {
    "default_view": "grid",
    "columns": 5
  },
  "metrics_interval": 0.5,
  "wallpaper": {
    "path": "/home/achinthyaj/Pictures/Wallpaper/launcherbackground.png"
  },
  "nightlight": {
    "enabled": false
  },
