{
  "theme": {
    "accent": "#7aa2f7",
    "opacity": 0.78,
    "radius": 28,
    "font_family": "JetBrains Mono",
    "preset": "Tokyo Night"
  },
  "bar": {
    "height": 36,
    "clock_format": "HH:mm",
    "show_date": true,
    "ws_width": 39,
    "ws_height": 14,
    "ws_radius": 7,
    "show_seconds": true,
    "show_gpu": true,
    "show_temp": true
  },
  "dock": {
    "enabled": true,
    "icon_size": 48,
    "auto_hide": true,
    "margin": 8,
    "monitor": ""
  },
  "launcher": {
    "default_view": "grid",
    "columns": 5
  },
  "shortcuts": [
    {
      "key": "SUPER, SPACE",
      "action": "open_launcher",
      "desc": "Toggle Application Launcher"
    },
    {
      "key": "SUPER, C",
      "action": "toggle_cc",
      "desc": "Toggle Control Center"
    },
    {
      "key": "SUPER, P",
      "action": "toggle_perf",
      "desc": "Toggle Performance Panel"
    },
    {
      "key": "SUPER, B",
      "action": "toggle_dock",
      "desc": "Show/Hide Dock"
    },
    {
      "key": "SUPER, L",
      "action": "lock",
      "desc": "Lock Session"
    },
    {
      "key": "SUPER, ESCAPE",
      "action": "power_menu",
      "desc": "Open Power Menu"
    }
  ],
  "metrics_interval": 0.5
}
