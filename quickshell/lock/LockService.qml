// Levish Flagship Lock Screen and Idle Management Service
//
// Dual-architecture security & luxury:
// - Generates a flagship, luxury Hyprlock configuration and Hypridle integration.
// - Real compositor-level security (desktop surfaces completely locked via Wayland ext-session-lock-v1 & PAM).
// - Zero plaintext logging, fully configurable live from Levish Settings.
import QtQuick
import Quickshell
import Quickshell.Io
import "widgets"
import "../common" as Pal

Item {
    id: svc

    required property var themeStore
    property var store: null

    readonly property string home: Quickshell.env("HOME") || ""
    readonly property string projectDir: {
        const d = String(Quickshell.shellDir).replace(/^file:\/\//, "").replace(/\/+$/, "")
        return d.substring(0, d.lastIndexOf("/"))
    }
    readonly property string stateDir: {
        const xdg = Quickshell.env("XDG_STATE_HOME")
        if (xdg && xdg !== "") return xdg + "/levish"
        if (home && home !== "") return home + "/.local/state/levish"
        return "/tmp/levish"
    }
    readonly property string hyprlockConf: stateDir + "/hyprlock.conf"
    readonly property string hypridleConf: stateDir + "/hypridle.conf"
    readonly property string scriptsDir: "/tmp/levish/scripts"

    // "off" | "idle-watch" | "error"
    property string status: "off"
    readonly property bool isLocked: lockProc.running

    // Weather backend service for the lock screen
    WeatherService {
        id: weatherSvc
        themeStore: svc.themeStore
    }

    Process {
        id: mkdirProc
        command: ["sh", "-c", "mkdir -p '" + svc.stateDir + "' /tmp/levish/scripts && for f in '" + svc.projectDir + "/scripts/'lock-*.sh; do cp -f \"$f\" /tmp/levish/scripts/ 2>/dev/null || true; done"]
    }

    // ── Lock / Unlock control ──────────────────────────────────────────────
    function lockNow() {
        mkdirProc.running = true
        apply()
        lockProc.running = false
        lockProc.command = ["hyprlock", "-c", svc.hyprlockConf]
        lockProc.running = true
    }

    function unlock() {
        if (lockProc.running) {
            lockProc.running = false
        }
    }

    // ── Hyprlock Config Generator ──────────────────────────────────────────
    function _rgba(hex, alpha) {
        const h = String(hex).replace("#", "")
        const r = parseInt(h.substring(0, 2), 16) || 200
        const g = parseInt(h.substring(2, 4), 16) || 247
        const b = parseInt(h.substring(4, 6), 16) || 239
        const a = (alpha !== undefined) ? alpha : 1.0
        return "rgba(" + r + ", " + g + ", " + b + ", " + a + ")"
    }

    function hyprlockText() {
        const wall = (svc.themeStore && !svc.themeStore.lockUseDesktopWallpaper && svc.themeStore.lockCustomWallpaperPath !== "")
                     ? svc.themeStore.lockCustomWallpaperPath
                     : (svc.themeStore ? svc.themeStore.wallpaperPath : "/usr/share/hypr/wall0.png")
        const accent = svc.themeStore ? svc.themeStore.accentColor : Pal.Palette.accent
        const font = svc.themeStore ? svc.themeStore.fontFamily : "JetBrains Mono"
        const blurPasses = svc.themeStore ? Math.max(1, Math.min(4, Math.round(svc.themeStore.lockBlur / 16))) : 3
        const blurSize = svc.themeStore ? Math.max(2, Math.min(10, Math.round(svc.themeStore.lockBlur / 5))) : 7
        const brightness = svc.themeStore ? Math.max(0.2, (1.0 - svc.themeStore.lockDimming * 0.7)).toFixed(2) : "0.72"
        const is12H = svc.themeStore ? (svc.themeStore.lockClockFormat.indexOf("AP") >= 0) : false
        const showSec = svc.themeStore ? svc.themeStore.lockShowSeconds : false
        const avatarPath = (svc.themeStore && svc.themeStore.lockCustomAvatar !== "")
                           ? svc.themeStore.lockCustomAvatar
                           : (svc.home + "/.face")
        const hideUser = svc.themeStore ? svc.themeStore.lockHideUserDetails : false
        const hideWidgets = svc.themeStore ? svc.themeStore.lockDisableWidgets : false
        const layout = svc.themeStore ? svc.themeStore.lockLayout : "cinematic"
        const pDir = svc.projectDir

        let conf = "# Levish Luxury Flagship Lock Screen Configuration\n"
            + "# Automatically generated by Levish Shell. Edit via Levish Settings.\n\n"
            + "general {\n"
            + "    hide_cursor = true\n"
            + "    ignore_empty_input = true\n"
            + "    immediate_render = true\n"
            + "    text_trim = true\n"
            + "}\n\n"

        // Background
        const bgPath = (wall && wall !== "") ? "    path = " + wall + "\n" : "    path = screenshot\n"
        conf += "background {\n"
            + "    monitor =\n"
            + bgPath
            + "    blur_passes = " + blurPasses + "\n"
            + "    blur_size = " + blurSize + "\n"
            + "    noise = 0.012\n"
            + "    contrast = 0.88\n"
            + "    brightness = " + brightness + "\n"
            + "    vibrancy = 0.2\n"
            + "    color = rgb(13, 16, 23)\n"
            + "}\n\n"

        const sDir = svc.scriptsDir

        // Generous vertical spacing & proportions across 1080p+ displays
        let clockY = 300
        let clockX = 0
        let clockAlign = "center"
        let clockGap = 110
        let dateY = 200
        let avatarY = 80
        let greetY = 10
        let inputY = -80
        let inputAlign = "center"
        let weatherY = -185
        let batteryY = -230
        let mediaY = -275

        if (layout === "editorial") {
            clockAlign = "left"
            clockX = 120
            clockY = 280
            clockGap = 105
            dateY = 190
            avatarY = 75
            greetY = 5
            inputAlign = "left"
            inputY = -85
            weatherY = -185
            batteryY = -230
            mediaY = -275
        } else if (layout === "minimal") {
            clockY = 140
            clockGap = 100
            dateY = 40
            inputY = -80
        }

        // Hero Clock: Hours (white)
        conf += "# Hero Clock: Hours\n"
            + "label {\n"
            + "    monitor =\n"
            + "    text = cmd[update:1000] date +\"" + (is12H ? "%I" : "%H") + "\"\n"
            + "    color = rgb(245, 249, 253)\n"
            + "    font_size = 96\n"
            + "    font_family = " + font + " ExtraBold\n"
            + "    position = " + (clockX - clockGap) + ", " + clockY + "\n"
            + "    halign = " + clockAlign + "\n"
            + "    valign = center\n"
            + "    shadow_passes = 2\n"
            + "    shadow_size = 10\n"
            + "    shadow_color = rgba(0, 0, 0, 0.6)\n"
            + "}\n\n"

        // Hero Clock: Breathing colon
        conf += "# Hero Clock: Colon\n"
            + "label {\n"
            + "    monitor =\n"
            + "    text = :\n"
            + "    color = " + _rgba(accent, 0.95) + "\n"
            + "    font_size = 90\n"
            + "    font_family = " + font + "\n"
            + "    position = " + clockX + ", " + (clockY + 2) + "\n"
            + "    halign = " + clockAlign + "\n"
            + "    valign = center\n"
            + "    shadow_passes = 2\n"
            + "    shadow_size = 10\n"
            + "    shadow_color = rgba(0, 0, 0, 0.6)\n"
            + "}\n\n"

        // Hero Clock: Minutes (accent turquoise)
        conf += "# Hero Clock: Minutes\n"
            + "label {\n"
            + "    monitor =\n"
            + "    text = cmd[update:1000] date +\"%M\"\n"
            + "    color = " + _rgba(accent, 1.0) + "\n"
            + "    font_size = 96\n"
            + "    font_family = " + font + " ExtraBold\n"
            + "    position = " + (clockX + clockGap) + ", " + clockY + "\n"
            + "    halign = " + clockAlign + "\n"
            + "    valign = center\n"
            + "    shadow_passes = 2\n"
            + "    shadow_size = 10\n"
            + "    shadow_color = rgba(0, 0, 0, 0.6)\n"
            + "}\n\n"

        // AM/PM badge if 12h
        if (is12H) {
            conf += "label {\n"
                + "    monitor =\n"
                + "    text = cmd[update:1000] date +\"%p\"\n"
                + "    color = " + _rgba(accent, 0.9) + "\n"
                + "    font_size = 20\n"
                + "    font_family = " + font + " Bold\n"
                + "    position = " + (clockX + clockGap + 85) + ", " + (clockY + 20) + "\n"
                + "    halign = " + clockAlign + "\n"
                + "    valign = center\n"
                + "}\n\n"
        }

        // Seconds badge if enabled
        if (showSec) {
            conf += "label {\n"
                + "    monitor =\n"
                + "    text = cmd[update:1000] date +\"%S\"\n"
                + "    color = rgb(159, 176, 198)\n"
                + "    font_size = 18\n"
                + "    font_family = " + font + "\n"
                + "    position = " + (clockX + clockGap + 85) + ", " + (clockY - 20) + "\n"
                + "    halign = " + clockAlign + "\n"
                + "    valign = center\n"
                + "}\n\n"
        }

        // Date Label
        conf += "# Date Label\n"
            + "label {\n"
            + "    monitor =\n"
            + "    text = cmd[update:60000] " + sDir + "/lock-date.sh\n"
            + "    color = rgb(226, 236, 247)\n"
            + "    font_size = 13\n"
            + "    font_family = " + font + "\n"
            + "    position = " + clockX + ", " + dateY + "\n"
            + "    halign = " + clockAlign + "\n"
            + "    valign = center\n"
            + "    shadow_passes = 2\n"
            + "    shadow_size = 6\n"
            + "    shadow_color = rgba(0, 0, 0, 0.6)\n"
            + "}\n\n"

        // User Avatar & Greeting
        if (!hideUser && layout !== "minimal") {
            conf += "# User Avatar\n"
                + "image {\n"
                + "    monitor =\n"
                + "    path = " + avatarPath + "\n"
                + "    size = 84\n"
                + "    rounding = -1\n"
                + "    border_size = 2\n"
                + "    border_color = " + _rgba(accent, 0.85) + "\n"
                + "    position = " + clockX + ", " + avatarY + "\n"
                + "    halign = " + clockAlign + "\n"
                + "    valign = center\n"
                + "    shadow_passes = 2\n"
                + "    shadow_size = 8\n"
                + "    shadow_color = rgba(0, 0, 0, 0.5)\n"
                + "}\n\n"

            // Dynamic Greeting & Name
            conf += "# Greeting & User Label\n"
                + "label {\n"
                + "    monitor =\n"
                + "    text = cmd[update:60000] " + sDir + "/lock-greeting.sh\n"
                + "    color = rgb(245, 249, 253)\n"
                + "    font_size = 15\n"
                + "    font_family = " + font + "\n"
                + "    position = " + clockX + ", " + greetY + "\n"
                + "    halign = " + clockAlign + "\n"
                + "    valign = center\n"
                + "    shadow_passes = 1\n"
                + "    shadow_size = 4\n"
                + "    shadow_color = rgba(0, 0, 0, 0.5)\n"
                + "}\n\n"
        }

        // Input Field
        conf += "# Password Input Field\n"
            + "input-field {\n"
            + "    monitor =\n"
            + "    size = 320, 48\n"
            + "    outline_thickness = 2\n"
            + "    dots_size = 0.28\n"
            + "    dots_spacing = 0.35\n"
            + "    dots_center = true\n"
            + "    dots_rounding = -1\n"
            + "    outer_color = " + _rgba(accent, 0.95) + "\n"
            + "    inner_color = rgba(18, 27, 36, 0.88)\n"
            + "    font_color = rgb(245, 249, 253)\n"
            + "    fade_on_empty = false\n"
            + "    font_family = " + font + "\n"
            + "    placeholder_text = <i>Enter password…</i>\n"
            + "    hide_input = false\n"
            + "    rounding = 24\n"
            + "    check_color = " + _rgba(accent, 1.0) + "\n"
            + "    fail_color = rgb(240, 112, 138)\n"
            + "    fail_text = <i>Incorrect password ($ATTEMPTS)</i>\n"
            + "    capslock_color = rgb(251, 146, 60)\n"
            + "    position = " + clockX + ", " + inputY + "\n"
            + "    halign = " + inputAlign + "\n"
            + "    valign = center\n"
            + "    shadow_passes = 2\n"
            + "    shadow_size = 12\n"
            + "    shadow_color = rgba(0, 0, 0, 0.45)\n"
            + "}\n\n"

        // Environmental Widgets (Weather, Battery, Media)
        if (!hideWidgets && layout !== "minimal") {
            // Weather
            if (svc.themeStore && svc.themeStore.lockShowWeather) {
                conf += "# Weather Label\n"
                    + "label {\n"
                    + "    monitor =\n"
                    + "    text = cmd[update:30000] " + sDir + "/lock-weather.sh\n"
                    + "    color = rgb(200, 218, 235)\n"
                    + "    font_size = 12\n"
                    + "    font_family = " + font + "\n"
                    + "    position = " + clockX + ", " + weatherY + "\n"
                    + "    halign = " + clockAlign + "\n"
                    + "    valign = center\n"
                    + "    shadow_passes = 1\n"
                    + "    shadow_size = 4\n"
                    + "    shadow_color = rgba(0, 0, 0, 0.5)\n"
                    + "}\n\n"
            }

            // Battery & Network
            if (svc.themeStore && svc.themeStore.lockShowBattery) {
                conf += "# Battery & Network Label\n"
                    + "label {\n"
                    + "    monitor =\n"
                    + "    text = cmd[update:5000] " + sDir + "/lock-battery.sh\n"
                    + "    color = rgb(159, 176, 198)\n"
                    + "    font_size = 11\n"
                    + "    font_family = " + font + "\n"
                    + "    position = " + clockX + ", " + batteryY + "\n"
                    + "    halign = " + clockAlign + "\n"
                    + "    valign = center\n"
                    + "    shadow_passes = 1\n"
                    + "    shadow_size = 4\n"
                    + "    shadow_color = rgba(0, 0, 0, 0.5)\n"
                    + "}\n\n"
            }

            // Media
            if (svc.themeStore && svc.themeStore.lockShowMedia) {
                conf += "# Media Playback Label\n"
                    + "label {\n"
                    + "    monitor =\n"
                    + "    text = cmd[update:3000] " + sDir + "/lock-media.sh\n"
                    + "    color = rgb(140, 162, 184)\n"
                    + "    font_size = 11\n"
                    + "    font_family = " + font + "\n"
                    + "    position = " + clockX + ", " + mediaY + "\n"
                    + "    halign = " + clockAlign + "\n"
                    + "    valign = center\n"
                    + "    shadow_passes = 1\n"
                    + "    shadow_size = 4\n"
                    + "    shadow_color = rgba(0, 0, 0, 0.5)\n"
                    + "}\n\n"
            }
        }

        return conf
    }

    function hypridleText() {
        const mins = svc.themeStore ? svc.themeStore.lockTimeoutMin : 0
        const projectDir = svc.themeStore ? svc.themeStore.projectDir : ""
        const lockCmd = (projectDir !== "")
                        ? (projectDir + "/scripts/levish-ipc.sh lock")
                        : ("hyprlock -c " + svc.hyprlockConf)

        let text = "general {\n"
            + "    lock_cmd = " + lockCmd + "\n"
            + (svc.themeStore && svc.themeStore.lockBeforeSleep ? "    before_sleep_cmd = loginctl lock-session\n" : "")
            + "    after_sleep_cmd = hyprctl dispatch dpms on\n"
            + "}\n"
        if (mins > 0) {
            text += "\nlistener {\n"
                + "    timeout = " + (mins * 60) + "\n"
                + "    on-timeout = " + lockCmd + "\n"
                + "}\n"
        }
        return text
    }

    // ── Files ───────────────────────────────────────────────────────────────
    FileView {
        id: hyprlockFile
        path: svc.hyprlockConf
        atomicWrites: true
        printErrors: false
    }
    FileView {
        id: tmpHyprlockFile
        path: "/tmp/levish/hyprlock.conf"
        atomicWrites: true
        printErrors: false
    }
    FileView {
        id: hypridleFile
        path: svc.hypridleConf
        atomicWrites: true
        printErrors: false
    }

    function apply() {
        const txt = svc.hyprlockText()
        hyprlockFile.setText(txt)
        tmpHyprlockFile.setText(txt)
        hypridleFile.setText(svc.hypridleText())
        const wantIdle = svc.themeStore && (svc.themeStore.lockTimeoutMin > 0 || svc.themeStore.lockBeforeSleep)
        idleProc.running = false
        if (wantIdle) {
            idleProc.command = ["hypridle", "-c", svc.hypridleConf]
            idleProc.running = true
            svc.status = "idle-watch"
        } else {
            svc.status = "off"
        }
    }

    Process {
        id: idleProc
        onExited: (code) => {
            if (svc.themeStore && (svc.themeStore.lockTimeoutMin > 0 || svc.themeStore.lockBeforeSleep)) {
                if (code !== 0) svc.status = "error"
            }
        }
    }

    Process {
        id: lockProc
        stderr: StdioCollector { id: lockErr }
        onExited: (code) => {
            if (code !== 0) console.warn("lock: hyprlock exited with " + code + " " + lockErr.text)
        }
    }

    Component.onCompleted: {
        mkdirProc.running = true
        apply()
    }

    Connections {
        target: svc.themeStore
        function onLockTimeoutMinChanged() { svc.apply() }
        function onLockBeforeSleepChanged() { svc.apply() }
        function onWallpaperPathChanged() { svc.apply() }
        function onAccentColorChanged() { svc.apply() }
        function onFontFamilyChanged() { svc.apply() }
        function onLockLayoutChanged() { svc.apply() }
        function onLockBlurChanged() { svc.apply() }
        function onLockDimmingChanged() { svc.apply() }
        function onLockClockFormatChanged() { svc.apply() }
        function onLockShowSecondsChanged() { svc.apply() }
        function onLockClockScaleChanged() { svc.apply() }
    }
}
